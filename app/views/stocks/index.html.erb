<div class="max-w-lg mx-auto mt-6 px-4">
  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold">🥦 冷蔵庫の野菜</h1>
    <%= link_to "+ 登録", new_stock_path, class: "bg-blue-500 text-white px-4 py-2 rounded" %>
  </div>

  <p class="text-xs text-gray-400 mb-4">※保存日数は一般的な目安です</p>

  <% if @stocks.empty? %>
    <div class="bg-gray-100 rounded p-6 text-center text-gray-500">
      野菜を登録してください
    </div>
  <% else %>
    <% @stocks.each do |stock| %>
      <% color = stock.priority_color %>
      <div class="border-l-4 <%= color == 'red' ? 'border-red-500' : color == 'yellow' ? 'border-yellow-500' : 'border-green-500' %> bg-white rounded shadow mb-3 p-4 flex justify-between items-center">
        <div>
          <p class="font-bold text-lg"><%= stock.vegetable.name %></p>
          <p class="text-sm text-gray-500">登録日: <%= stock.purchased_on.strftime('%m/%d') %>　残り: <%= [stock.vegetable.shelf_life_days - stock.elapsed_days, 0].max %>日</p>
          <span class="text-xs text-white px-2 py-1 rounded <%= color == 'red' ? 'bg-red-500' : color == 'yellow' ? 'bg-yellow-500' : 'bg-green-500' %>">
            <%= color == 'red' ? '要注意' : color == 'yellow' ? '注意' : '新鮮' %>
          </span>
        </div>
        <%= button_to "食べきった！", stock_path(stock), method: :delete,
            class: "text-white px-3 py-2 rounded text-sm #{color == 'red' ? 'bg-red-500' : color == 'yellow' ? 'bg-yellow-500' : 'bg-green-500'}" %>
      </div>
    <% end %>
  <% end %>
</div>