<div class="max-w-lg mx-auto mt-6 px-4">
  <div class="flex items-center mb-4">
    <%= link_to "← 戻る", new_stock_path, class: "text-gray-500 mr-4" %>
    <h1 class="text-xl font-bold">その他の野菜を登録</h1>
  </div>

  <p class="text-sm text-gray-500 mb-4">一覧にない野菜を入力してください</p>

  <%= form_with url: others_path do |f| %>
    <div class="mb-4">
      <%= f.label :vegetable_name, "野菜名", class: "block mb-1 font-bold" %>
      <%= f.text_field :vegetable_name,
          placeholder: "例：ごぼう、みずな、しゅんぎく…",
          class: "border-2 border-green-500 rounded w-full p-3" %>
    </div>

    <p class="text-xs text-gray-400 mb-6">
      ※「その他」の野菜にはデフォルトの保存日数（5日）が適用されます
    </p>

    <%= f.submit "登録する", class: "w-full bg-green-500 text-white py-3 rounded font-bold" %>
  <% end %>
</div>