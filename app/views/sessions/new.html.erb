<div class="text-center mb-4">
  <%= link_to "← トップページに戻る", root_path, class: "text-gray-500 text-sm" %>
</div>
<div class="max-w-md mx-auto mt-10">
  <h1 class="text-2xl font-bold mb-6">ログイン</h1>

  <% if flash[:alert] %>
    <div class="bg-red-100 text-red-700 p-3 rounded mb-4">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_with url: login_path do |f| %>
    <div class="mb-4">
      <%= f.label :email, "メールアドレス", class: "block mb-1" %>
      <%= f.email_field :email, class: "border rounded w-full p-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :password, "パスワード", class: "block mb-1" %>
      <%= f.password_field :password, class: "border rounded w-full p-2" %>
    </div>

    <%= f.submit "ログインする", class: "bg-blue-500 text-white px-4 py-2 rounded w-full" %>
  <% end %>

  <p class="mt-4 text-center">
    アカウントをお持ちでない方は <%= link_to "新規登録", signup_path, class: "text-green-500" %>
  </p>
</div>