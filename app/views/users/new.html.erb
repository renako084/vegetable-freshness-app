<div class="max-w-md mx-auto mt-10">
  <h1 class="text-2xl font-bold mb-6">アカウント登録</h1>

  <%= form_with model: @user, url: signup_path do |f| %>
    <% if @user.errors.any? %>
      <div class="bg-red-100 text-red-700 p-3 rounded mb-4">
        <% @user.errors.each do |error| %>
          <p><%= error.full_message
                  .gsub("Email", "メールアドレス")
                  .gsub("Password confirmation", "パスワード確認")
                  .gsub("Password", "パスワード")
                  .gsub("doesn't match Password", "がパスワードと一致しません") %></p>
        <% end %>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :email, "メールアドレス", class: "block mb-1" %>
      <%= f.email_field :email, class: "border rounded w-full p-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :password, "パスワード", class: "block mb-1" %>
      <%= f.password_field :password, class: "border rounded w-full p-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :password_confirmation, "パスワード確認", class: "block mb-1" %>
      <%= f.password_field :password_confirmation, class: "border rounded w-full p-2" %>
    </div>

    <%= f.submit "登録する", class: "bg-green-500 text-white px-4 py-2 rounded w-full" %>
  <% end %>

  <p class="mt-4 text-center">
    すでにアカウントをお持ちの方は <%= link_to "ログイン", login_path, class: "text-blue-500" %>
  </p>
</div>